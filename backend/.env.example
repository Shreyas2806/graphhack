# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# FalkorDB Database Configuration
# Local Docker development defaults:
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=graphmind

# Hosted FalkorDB Cloud (Optional - leave blank if running local Docker)
# Option 1: Host + Port + Password
# FALKORDB_HOST=your-instance.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=your_falkordb_password_here
# FALKORDB_USERNAME=default
# FALKORDB_SSL=true

# Option 2: Full Connection URL
# FALKORDB_URL=falkors://default:password@your-instance.falkordb.cloud:6379

# In-Memory Caching Configuration
ENABLE_CACHE=true
CACHE_TTL_SECONDS=60.0
